{
  "openapi": "3.0.3",
  "info": {
    "title": "Flock Energy — Legacy Urja Meter Ops API Service",
    "description": "A clean, documented, production-minded REST API service built over the legacy Urja Meter Ops portal. Exposes smart-meter nameplate parameters, interval consumption time-series, geographic coordinates, distribution transformer metadata, and complete multi-tier network hierarchy.",
    "version": "1.0.0",
    "contact": {
      "name": "Engineering Operations Desk"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Returns operational status, ISO timestamp, and process uptime.",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok",
                  "timestamp": "2026-10-27T18:15:00.000Z",
                  "uptime": 12.34
                }
              }
            }
          }
        }
      }
    },
    "/api/meters": {
      "get": {
        "summary": "List smart meters",
        "description": "Retrieves a paginated list of smart meters. Supports search query filtering by meter number or serial.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Optional search term for meter ID or serial number",
            "required": false,
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number (1-indexed)",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated meters list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetersListResponse"
                },
                "example": {
                  "data": [
                    {
                      "meterId": "J100000",
                      "serialNo": "SE33962",
                      "make": "HPL",
                      "phaseType": "single",
                      "installStatus": "Decommissioned",
                      "dtCode": "DT-001"
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "pageSize": 20,
                    "total": 403,
                    "totalPages": 21
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400ValidationError"
          },
          "502": {
            "$ref": "#/components/responses/502PortalError"
          }
        }
      }
    },
    "/api/meters/query": {
      "get": {
        "summary": "Advanced multi-attribute & geo-proximity meter search",
        "description": "Enables multi-attribute queries that the legacy portal cannot easily answer (e.g. filtering across make, phase, status, DT, feeder) and geo-proximity search returning meters within a radius of GPS coordinates sorted by distance.",
        "parameters": [
          { "name": "make", "in": "query", "description": "Filter by meter manufacturer (e.g. HPL, L&T, Allied)", "schema": { "type": "string" } },
          { "name": "phaseType", "in": "query", "description": "Filter by phase type", "schema": { "type": "string", "enum": ["single", "three"] } },
          { "name": "installStatus", "in": "query", "description": "Filter by installation status (e.g. Installed, Decommissioned)", "schema": { "type": "string" } },
          { "name": "dtCode", "in": "query", "description": "Filter by Distribution Transformer code (e.g. DT-001)", "schema": { "type": "string" } },
          { "name": "feederCode", "in": "query", "description": "Filter by Feeder code (e.g. F-001)", "schema": { "type": "string" } },
          { "name": "nearLat", "in": "query", "description": "Center latitude for proximity search (-90 to 90)", "schema": { "type": "number" } },
          { "name": "nearLng", "in": "query", "description": "Center longitude for proximity search (-180 to 180)", "schema": { "type": "number" } },
          { "name": "maxDistanceKm", "in": "query", "description": "Maximum search radius in kilometers (default 5 km)", "schema": { "type": "number", "default": 5 } },
          { "name": "page", "in": "query", "description": "Page number (1-indexed)", "schema": { "type": "integer", "default": 1 } },
          { "name": "pageSize", "in": "query", "description": "Items per page (max 100)", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated matching meters, sorted by distance if nearLat/nearLng provided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetersListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400ValidationError"
          },
          "502": {
            "$ref": "#/components/responses/502PortalError"
          }
        }
      }
    },
    "/api/meters/{id}": {
      "get": {
        "summary": "Get meter detail",
        "description": "Retrieves complete nameplate, installation status, geographical coordinates (lat/lng), and electricity distribution hierarchy for a specific meter.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Meter identifier (e.g. J100000)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full meter details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetailResponse"
                },
                "example": {
                  "data": {
                    "meterId": "J100000",
                    "serialNo": "SE33962",
                    "make": "HPL",
                    "phaseType": "single",
                    "installStatus": "Decommissioned",
                    "installType": "Whole Current",
                    "hierarchy": {
                      "zone": { "name": "Jaipur Zone 1", "code": "Z-01" },
                      "circle": { "name": "Circle 1", "code": "C-01" },
                      "division": { "name": "Division 1", "code": "D-01" },
                      "subdivision": { "name": "Subdivision 1", "code": "SD-01" },
                      "substation": { "name": "Substation 1", "code": "SS-01" },
                      "feeder": { "name": "Feeder 1", "code": "F-001" },
                      "dt": { "name": "Malviya Nagar DT 1", "code": "DT-001" }
                    },
                    "geo": {
                      "latitude": 26.938961,
                      "longitude": 75.830956
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/404NotFound"
          },
          "502": {
            "$ref": "#/components/responses/502PortalError"
          }
        }
      }
    },
    "/api/meters/{id}/consumption": {
      "get": {
        "summary": "Get meter consumption history",
        "description": "Retrieves chronological interval consumption, apparent power, and phase voltage readings for a smart meter.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Meter identifier (e.g. J100000)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Optional maximum number of readings to return",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Start date for interval filtering (ISO string or YYYY-MM-DD or DD/MM/YYYY)",
            "schema": { "type": "string" }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "End date for interval filtering (ISO string or YYYY-MM-DD or DD/MM/YYYY)",
            "schema": { "type": "string" }
          },
          {
            "name": "summary",
            "in": "query",
            "required": false,
            "description": "Include telemetry summary calculations (total kWh consumed, min/max/avg voltage). Defaults to true.",
            "schema": { "type": "boolean", "default": true }
          }
        ],
        "responses": {
          "200": {
            "description": "Consumption history readings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumptionResponse"
                },
                "example": {
                  "data": {
                    "meterId": "J100000",
                    "totalReadings": 337,
                    "readings": [
                      {
                        "timestamp": "23/06/2026 23:30",
                        "kwh": 48438.74,
                        "kvah": 52313.84,
                        "voltageR": 226
                      }
                    ]
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/404NotFound"
          },
          "502": {
            "$ref": "#/components/responses/502PortalError"
          }
        }
      }
    },
    "/api/transformers": {
      "get": {
        "summary": "List distribution transformers",
        "description": "Retrieves paginated Distribution Transformers (DTs) with feeder mapping and rated kVA capacity.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number (1-indexed)",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated transformers list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransformersListResponse"
                },
                "example": {
                  "data": [
                    {
                      "code": "DT-001",
                      "name": "Malviya Nagar DT 1",
                      "feederCode": "F-001",
                      "capacityKva": 100
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "pageSize": 20,
                    "total": 40,
                    "totalPages": 2
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400ValidationError"
          },
          "502": {
            "$ref": "#/components/responses/502PortalError"
          }
        }
      }
    },
    "/api/network": {
      "get": {
        "summary": "Get full electricity distribution network hierarchy",
        "description": "Reconstructs the hierarchical structure of the distribution grid: Zone → Circle → Division → Subdivision → Substation → Feeder → Distribution Transformer → Connected Smart Meters. Includes aggregate network statistics.",
        "responses": {
          "200": {
            "description": "Complete network tree and statistics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NetworkResponse"
                },
                "example": {
                  "data": {
                    "statistics": {
                      "totalZones": 3,
                      "totalCircles": 7,
                      "totalDivisions": 10,
                      "totalSubstations": 19,
                      "totalFeeders": 29,
                      "totalDts": 40,
                      "totalMeters": 403
                    },
                    "zones": [
                      {
                        "code": "Z-01",
                        "name": "Jaipur Zone 1",
                        "type": "zone",
                        "meterCount": 135,
                        "children": []
                      }
                    ]
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/502PortalError"
          }
        }
      }
    },
    "/api/export": {
      "get": {
        "summary": "Bulk meter dataset export",
        "description": "Retrieves the complete bulk export of meters including full hierarchy and coordinates. Transparently signs requests with upstream portal HMAC-SHA256 signature keys.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bulk meter records",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportResponse"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/502PortalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "uptime": { "type": "number" }
        },
        "required": ["status", "timestamp", "uptime"]
      },
      "ApiMeterSummary": {
        "type": "object",
        "properties": {
          "meterId": { "type": "string" },
          "serialNo": { "type": "string" },
          "make": { "type": "string" },
          "phaseType": { "type": "string" },
          "installStatus": { "type": "string" },
          "dtCode": { "type": "string" }
        },
        "required": ["meterId", "serialNo", "make", "phaseType", "installStatus", "dtCode"]
      },
      "MetersListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ApiMeterSummary" }
          },
          "pagination": { "$ref": "#/components/schemas/PaginationMetadata" }
        },
        "required": ["data", "pagination"]
      },
      "MeterDetailResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "meterId": { "type": "string" },
              "serialNo": { "type": "string" },
              "make": { "type": "string" },
              "phaseType": { "type": "string" },
              "installStatus": { "type": "string" },
              "installType": { "type": "string" },
              "hierarchy": { "type": "object" },
              "geo": {
                "type": "object",
                "nullable": true,
                "properties": {
                  "latitude": { "type": "number" },
                  "longitude": { "type": "number" }
                }
              }
            },
            "required": ["meterId", "serialNo", "make", "phaseType", "installStatus", "installType", "hierarchy", "geo"]
          }
        },
        "required": ["data"]
      },
      "ConsumptionResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "meterId": { "type": "string" },
              "totalReadings": { "type": "integer" },
              "filteredCount": { "type": "integer", "description": "Number of readings matching the date-range filter" },
              "summary": {
                "type": "object",
                "description": "Telemetry analytics computed over the filtered window (included when summary is not false)",
                "properties": {
                  "readingCount": { "type": "integer" },
                  "period": {
                    "type": "object",
                    "properties": {
                      "from": { "type": "string", "nullable": true },
                      "to": { "type": "string", "nullable": true }
                    }
                  },
                  "activeEnergyKwh": {
                    "type": "object",
                    "properties": {
                      "start": { "type": "number", "nullable": true },
                      "end": { "type": "number", "nullable": true },
                      "totalConsumed": { "type": "number", "nullable": true }
                    }
                  },
                  "voltageStats": {
                    "type": "object",
                    "properties": {
                      "min": { "type": "number", "nullable": true },
                      "max": { "type": "number", "nullable": true },
                      "avg": { "type": "number", "nullable": true }
                    }
                  }
                }
              },
              "readings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "timestamp": { "type": "string" },
                    "kwh": { "type": "number", "nullable": true },
                    "kvah": { "type": "number", "nullable": true },
                    "voltageR": { "type": "number", "nullable": true }
                  },
                  "required": ["timestamp", "kwh", "kvah", "voltageR"]
                }
              }
            },
            "required": ["meterId", "totalReadings", "filteredCount", "readings"]
          }
        },
        "required": ["data"]
      },
      "TransformersListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": { "type": "string" },
                "name": { "type": "string" },
                "feederCode": { "type": "string" },
                "capacityKva": { "type": "number" }
              },
              "required": ["code", "name", "feederCode", "capacityKva"]
            }
          },
          "pagination": { "$ref": "#/components/schemas/PaginationMetadata" }
        },
        "required": ["data", "pagination"]
      },
      "NetworkResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "statistics": {
                "type": "object",
                "properties": {
                  "totalZones": { "type": "integer" },
                  "totalCircles": { "type": "integer" },
                  "totalDivisions": { "type": "integer" },
                  "totalSubstations": { "type": "integer" },
                  "totalFeeders": { "type": "integer" },
                  "totalDts": { "type": "integer" },
                  "totalMeters": { "type": "integer" }
                }
              },
              "zones": { "type": "array", "items": { "type": "object" } }
            },
            "required": ["statistics", "zones"]
          }
        },
        "required": ["data"]
      },
      "ExportResponse": {
        "type": "object",
        "properties": {
          "data": { "type": "array", "items": { "type": "object" } },
          "total": { "type": "integer" }
        },
        "required": ["data", "total"]
      },
      "PaginationMetadata": {
        "type": "object",
        "properties": {
          "page": { "type": "integer" },
          "pageSize": { "type": "integer" },
          "total": { "type": "integer" },
          "totalPages": { "type": "integer" }
        },
        "required": ["page", "pageSize", "total", "totalPages"]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": { "type": "object" }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      }
    },
    "responses": {
      "400ValidationError": {
        "description": "Validation error on request parameters",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
            "example": {
              "error": {
                "code": "VALIDATION_ERROR",
                "message": "Invalid request parameters",
                "details": [{ "path": "page", "message": "page must be at least 1" }]
              }
            }
          }
        }
      },
      "404NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
            "example": {
              "error": {
                "code": "NOT_FOUND",
                "message": "Meter with ID 'NONEXISTENT' not found"
              }
            }
          }
        }
      },
      "502PortalError": {
        "description": "Upstream Urja portal failure or unexpected response",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
            "example": {
              "error": {
                "code": "UPSTREAM_ERROR",
                "message": "Failed to fetch from portal at /portal/meters/search"
              }
            }
          }
        }
      }
    }
  }
}
