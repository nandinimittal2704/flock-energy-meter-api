# ──────────────────────────────────────────────
# Flock Energy API — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Urja Meter Ops Portal ────────────────────
PORTAL_BASE_URL=https://urja-ops.flockenergy.tech
PORTAL_EMAIL=your-email@example.com
PORTAL_PASSWORD=your-password-here

# ── Portal Client Tuning ─────────────────────
PORTAL_TIMEOUT_MS=10000
PORTAL_MAX_RETRIES=2
